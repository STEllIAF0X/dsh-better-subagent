{
  "name": "dsh-better-subagent",
  "version": "0.1.0",
  "description": "Better subagents for DeepSeek Harness: choose the default subagent model, see each subagent conversation's model in its header, and wait for subagents with a blocking wait_subagents tool instead of sleeping or polling.",
  "type": "module",
  "license": "MIT",
  "author": "STEllIAF0X",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stelliaf0x/dsh-better-subagent.git"
  },
  "homepage": "https://github.com/stelliaf0x/dsh-better-subagent#readme",
  "bugs": {
    "url": "https://github.com/stelliaf0x/dsh-better-subagent/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "subagent",
    "subagents",
    "agent",
    "model",
    "plugin"
  ],
  "main": "lib/host.js",
  "exports": {
    ".": {
      "default": "./lib/host.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
